#!/bin/bash
# Résumé de l'état du serveur LWS pour la page « état du serveur » de Tam-Tam (audit du 19/11/2026).
# Lancé par auto-maj toutes les 5 minutes (en tant que root, sur le serveur). Écrit /var/lib/tam-tam-etat/etat.json,
# que le conteneur Tam-Tam lit en lecture seule. Contenu : connexions à distance (SSH) acceptées et refusées,
# empreintes des clés d'accès, comptes du système qui peuvent se connecter, programmes (conteneurs) lancés,
# place sur le disque, fin du journal des mises à jour. Aucun mot de passe ni aucune donnée des membres.
OUT=/var/lib/tam-tam-etat; mkdir -p "$OUT"; chmod 755 "$OUT"
command -v python3 >/dev/null || { echo '{"erreur":"python3 absent sur le serveur"}' > "$OUT/etat.json"; exit 0; }
# Les relevés passent par des fichiers temporaires (et non par des variables) : sur un serveur exposé,
# le journal des connexions refusées peut être énorme et dépasser la taille permise pour une variable.
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
{ journalctl -u ssh -u sshd --since "7 days ago" --no-pager -o short-iso 2>/dev/null; grep -h sshd /var/log/auth.log /var/log/auth.log.1 2>/dev/null; } | grep -E "Accepted|Failed password|Invalid user" | tail -n 20000 > "$T/ssh"
for f in /root/.ssh/authorized_keys /home/*/.ssh/authorized_keys; do [ -f "$f" ] && ssh-keygen -lf "$f" 2>/dev/null | sed "s|^|$f |"; done > "$T/keys"
getent passwd | awk -F: '$7 !~ /(nologin|false|sync|halt|shutdown)$/ {print $1":"$3":"$7}' > "$T/users"
getent group sudo wheel 2>/dev/null | cut -d: -f4 | tr ',' '\n' | sort -u > "$T/sudo"
docker ps --format '{{.Names}} {{.Image}} {{.Status}}' > "$T/dock" 2>/dev/null
df -P / | awk 'NR==2 {print $5}' > "$T/disk"
tail -n 15 /var/log/tam-tam-auto-maj.log > "$T/maj" 2>/dev/null
# Capacité (21/11/2026) : octets reçus et envoyés par le serveur (toutes cartes réseau sauf « lo »), pour le débit moyen
# depuis le relevé précédent (environ 5 minutes) ; c'est là que pèsent les appels qui passent par le relais.
awk -F'[: ]+' 'NR>2 && $2!="lo" {rx+=$3; tx+=$11} END {print rx, tx}' /proc/net/dev > "$T/net" 2>/dev/null
cp "$OUT/net.prev" "$T/netprev" 2>/dev/null; { cat "$T/net"; date +%s; } | tr '\n' ' ' > "$OUT/net.prev"
nproc > "$T/cpu" 2>/dev/null; cat /proc/loadavg > "$T/load" 2>/dev/null; grep -E '^(MemTotal|MemAvailable):' /proc/meminfo > "$T/mem" 2>/dev/null
# Garde contre les robots (fail2ban, audit du 20/11/2026) : nombre d'adresses bloquées.
{ command -v fail2ban-client >/dev/null 2>&1 && timeout 10 fail2ban-client status sshd 2>/dev/null; } > "$T/f2b"
python3 - "$OUT/etat.json" "$T" <<'PY' || echo '{"erreur":"le resume du serveur n a pas pu etre ecrit"}' > "$OUT/etat.json"
import json, os, re, sys, time
def e(name):
    try:
        with open(os.path.join(sys.argv[2], name), errors='replace') as f: return f.read()
    except Exception: return ''
log = [l for l in e('ssh').splitlines() if l.strip()]
acc = []
for l in log:
    m = re.search(r'Accepted (\S+) for (\S+) from (\S+)', l)
    if m: acc.append({'ligne': l[:32], 'methode': m.group(1), 'compte': m.group(2), 'depuis': m.group(3)})
fail = [l for l in log if 'Failed password' in l or 'Invalid user' in l]
ips = {}
for l in fail:
    m = re.search(r'from (\S+)', l)
    if m: ips[m.group(1)] = ips.get(m.group(1), 0) + 1
out = {
  'ecrit': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
  'ssh': {'connexionsAcceptees7j': acc[-30:], 'nombreAcceptees7j': len(acc), 'essaisRefuses7j': len(fail),
          'adressesLesPlusInsistantes': sorted(ips.items(), key=lambda x: -x[1])[:8]},
  'clesAcces': [k for k in e('keys').splitlines() if k.strip()],
  'comptesQuiPeuventSeConnecter': [u for u in e('users').splitlines() if u.strip()],
  'administrateursSysteme': e('sudo').split(),
  'conteneurs': [d for d in e('dock').splitlines() if d.strip()],
  'disqueUtilise': e('disk').strip(),
  'misesAJour': [m for m in e('maj').splitlines() if m.strip()],
  'reseau': (lambda a, b: {'mbpsEntrant': round((a[0]-b[0])*8/max(1, a[2]-b[2])/1e6, 2), 'mbpsSortant': round((a[1]-b[1])*8/max(1, a[2]-b[2])/1e6, 2), 'surSecondes': a[2]-b[2], 'mesure': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}
             if len(a) == 3 and len(b) == 3 and a[2] > b[2] and a[0] >= b[0] and a[1] >= b[1] else 'premier relevé')(
             [int(x) for x in (e('net').split() + [str(int(time.time()))])[:3] if x.isdigit()], [int(x) for x in e('netprev').split()[:3] if x.isdigit()]),
  'processeurs': e('cpu').strip(), 'charge': e('load').split()[:3],
  'memoire': {l.split(':')[0]: int(l.split()[1]) // 1024 for l in e('mem').splitlines() if len(l.split()) > 1},
  'gardeRobots': (lambda t: {'enMarche': True, 'bloqueesMaintenant': int((re.search(r'Currently banned:\s*(\d+)', t) or [0, 0])[1]),
                              'bloqueesDepuisDemarrage': int((re.search(r'Total banned:\s*(\d+)', t) or [0, 0])[1])} if 'Currently banned' in t else 'non installé ou arrêté')(e('f2b')),
}
tmp = sys.argv[1] + '.tmp'
with open(tmp, 'w') as f: json.dump(out, f, ensure_ascii=False, indent=1)
os.chmod(tmp, 0o644); os.replace(tmp, sys.argv[1])
PY
exit 0
