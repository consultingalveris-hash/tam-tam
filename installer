#!/usr/bin/env bash
# Installe (ou met à jour) tam-tam v1 à côté du CRM et de Genius Recrutement, sans les redémarrer :
# un conteneur fait tourner l'application, et le Caddy du CRM (déjà sur les ports 80/443)
# reçoit un bloc pour tam-tam.alveris-consulting.com.
# Usage : cd ~/tam-tam && git pull && bash installer
set -euo pipefail
DOMAINE=tam-tam.alveris-consulting.com
APP=tam-tam-app
VOLUME=tam-tam-data
PROPRIETAIRE="${PROPRIETAIRE:-ngossodesire@gmail.com}"
DOSSIER="$(cd "$(dirname "$0")" && pwd)"

C=$(docker ps --format '{{.Names}}' | grep -E 'caddy' | head -n1 || true)
[ -n "$C" ] || { echo "ERREUR : conteneur Caddy du CRM introuvable."; exit 1; }
CF=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/etc/caddy/Caddyfile"}}{{.Source}}{{end}}{{end}}' "$C")
if [ -z "$CF" ]; then
  D=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/etc/caddy"}}{{.Source}}{{end}}{{end}}' "$C")
  [ -n "$D" ] && CF="$D/Caddyfile"
fi
[ -n "$CF" ] && [ -f "$CF" ] || { echo "ERREUR : Caddyfile du CRM introuvable."; exit 1; }
NET=$(docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' "$C" | head -n1)
echo "Caddy du CRM : $C — réseau : $NET"

# Mémoire de secours (swap) : évite que le serveur se bloque si la mémoire vive est pleine.
if [ -z "$(swapon --show --noheadings 2>/dev/null)" ]; then
  if [ ! -f /swapfile ]; then fallocate -l 2G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none; chmod 600 /swapfile; mkswap /swapfile >/dev/null; fi
  swapon /swapfile && { grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab; } && echo "Mémoire de secours activée (2 Go)."
fi
sysctl -q vm.swappiness=20 2>/dev/null || true

# Relais d'appels (TURN) : aide les appels à passer quand les réseaux mobiles bloquent la connexion directe.
SECRET_TURN_F=/root/.tam-tam-turn
[ -s "$SECRET_TURN_F" ] || { head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$SECRET_TURN_F"; chmod 600 "$SECRET_TURN_F"; }
SECRET_TURN=$(cat "$SECRET_TURN_F")
IP_PUB=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -n1)
docker rm -f tam-tam-turn >/dev/null 2>&1 || true
if docker run -d --name tam-tam-turn --restart unless-stopped --network host --memory 256m coturn/coturn:4.6 -n \
  --listening-port=3478 --fingerprint --use-auth-secret --static-auth-secret="$SECRET_TURN" --realm="$DOMAINE" \
  --min-port=49160 --max-port=49200 --no-cli --no-tls --no-dtls --no-multicast-peers --log-file=stdout \
  ${IP_PUB:+--external-ip="$IP_PUB"} \
  --denied-peer-ip=10.0.0.0-10.255.255.255 --denied-peer-ip=172.16.0.0-172.31.255.255 \
  --denied-peer-ip=192.168.0.0-192.168.255.255 --denied-peer-ip=127.0.0.0-127.255.255.255 >/dev/null; then
  echo "Relais d'appels lancé."
  if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "Status: active"; then ufw allow 3478 >/dev/null; ufw allow 49160:49200/udp >/dev/null; fi
else
  echo "ATTENTION : relais d'appels non lancé (les appels marcheront sur la plupart des réseaux, pas tous)."; SECRET_TURN=""
fi

# Clé qui protège une seconde fois les sauvegardes de clés de chiffrement (gardée hors de la base de données).
SECRET_BK_F=/root/.tam-tam-backup-key
[ -s "$SECRET_BK_F" ] || { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$SECRET_BK_F"; chmod 600 "$SECRET_BK_F"; }
SECRET_BK=$(cat "$SECRET_BK_F")

echo "Construction de tam-tam (une minute la première fois)…"
docker build -q -t "$APP:latest" "$DOSSIER/app" >/dev/null
docker volume create "$VOLUME" >/dev/null
docker rm -f "$APP" >/dev/null 2>&1 || true
docker run -d --name "$APP" --restart unless-stopped --network "$NET" --memory 512m \
  -v "$VOLUME:/data" \
  -e BASE_URL="https://$DOMAINE" -e OWNER_EMAIL="$PROPRIETAIRE" \
  -e TURN_SECRET="$SECRET_TURN" -e TURN_HOST="$DOMAINE" -e BACKUP_KEY="$SECRET_BK" \
  "$APP:latest" >/dev/null
sleep 3
docker exec "$APP" node -e "fetch('http://localhost:3000/api/meta').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" \
  || { echo "ERREUR : tam-tam ne démarre pas. Journal :"; docker logs --tail 30 "$APP"; exit 1; }
echo "tam-tam lancé."

if ! grep -q "^$DOMAINE" "$CF"; then
  SAUVE="$CF.avant-tamtam-$(date +%Y%m%d-%H%M%S)"
  cp -p "$CF" "$SAUVE"
  cat >> "$CF" <<BLOC

$DOMAINE {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	request_body {
		max_size 8MB
	}
	reverse_proxy $APP:3000 {
		flush_interval -1
	}
}
BLOC
  if ! docker exec "$C" caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
    cat "$SAUVE" > "$CF"
    echo "ERREUR : configuration refusée, le Caddyfile du CRM a été remis comme avant."
    exit 1
  fi
  docker exec "$C" caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1
  echo "Adresse ajoutée : https://$DOMAINE"
fi
echo
docker stats --no-stream --format "{{.Name}} {{.MemUsage}}" 2>/dev/null || true
free -m | head -3
echo "TERMINE : https://$DOMAINE"
echo "Premier compte : créez-le avec l'adresse $PROPRIETAIRE."
