#!/bin/bash
# Mise à jour automatique (lancée toutes les 5 minutes par une minuterie systemd : tam-tam-auto-maj.timer) :
# - si la branche main (version validée) a changé sur GitHub : git pull + bash installer (vrai site) ;
# - si la branche essai a changé : bash essai (site d'essai).
# Journal : /var/log/tam-tam-auto-maj.log
# Mise en route (une seule fois, sur le serveur) :  bash auto-maj activer   → minuterie systemd toutes les 5 minutes.
# Arrêt :  bash auto-maj desactiver
{
if [ "$1" = activer ]; then
  D=$(dirname "$(readlink -f "$0")")
  printf '[Unit]\nDescription=Tam-Tam : mise a jour automatique\n[Service]\nType=oneshot\nEnvironment=HOME=/root\nExecStart=/bin/bash %s/auto-maj\n' "$D" > /etc/systemd/system/tam-tam-auto-maj.service
  printf '[Unit]\nDescription=Tam-Tam : mise a jour automatique toutes les 5 minutes\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=5min\nPersistent=true\n[Install]\nWantedBy=timers.target\n' > /etc/systemd/system/tam-tam-auto-maj.timer
  systemctl daemon-reload && systemctl enable --now tam-tam-auto-maj.timer && echo "MISE A JOUR AUTOMATIQUE ACTIVEE (toutes les 5 minutes)."
  exit 0
fi
if [ "$1" = desactiver ]; then systemctl disable --now tam-tam-auto-maj.timer; echo "Mise a jour automatique arretee."; exit 0; fi
cd "$(dirname "$(readlink -f "$0")")" || exit 1
exec 9>/tmp/tam-tam-auto-maj.lock; flock -n 9 || exit 0
LOG=/var/log/tam-tam-auto-maj.log
git fetch -q origin 2>>"$LOG" || { [ -f etat-hote ] && bash etat-hote >/dev/null 2>&1; exit 0; }
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  echo "$(date '+%F %T') vrai site : mise à jour vers $(git log -1 --format='%h %s' origin/main)" >> "$LOG"
  if git pull -q --ff-only origin main >> "$LOG" 2>&1; then bash installer >> "$LOG" 2>&1; echo "$(date '+%F %T') vrai site : terminé" >> "$LOG"
  else echo "$(date '+%F %T') ATTENTION : git pull refusé (modifications locales ?)" >> "$LOG"; fi
fi
if [ -d ../tam-tam-essai ] && [ "$(git -C ../tam-tam-essai rev-parse HEAD)" != "$(git rev-parse origin/essai)" ]; then
  echo "$(date '+%F %T') site d'essai : mise à jour vers $(git log -1 --format='%h %s' origin/essai)" >> "$LOG"
  bash essai >> "$LOG" 2>&1; echo "$(date '+%F %T') site d'essai : terminé" >> "$LOG"
fi
# Résumé de l'état du serveur pour la page « état du serveur » (audit de sécurité quotidien).
[ -f etat-hote ] && bash etat-hote >/dev/null 2>>"$LOG"
exit 0
}
