#!/usr/bin/env bash
# Met à jour le SITE D'ESSAI (https://essai.tam-tam.africa) avec la version en préparation.
# Usage, depuis ~/tam-tam :  bash essai
# Le vrai site n'est pas touché. Quand la version est validée sur le site d'essai :  git pull && bash installer
set -euo pipefail
cd "$(dirname "$0")"
git fetch -q origin
[ -d ../tam-tam-essai ] || git worktree add -q --detach ../tam-tam-essai origin/essai
git -C ../tam-tam-essai checkout -q --detach origin/essai
# Audit du 20/11/2026 : l'installateur utilisé est celui de la version validée (ce dossier), pas celui de la branche essai ;
# seule l'application de la branche essai est construite (dans son conteneur).
ESSAI_DOSSIER="$(cd ../tam-tam-essai && pwd)" bash installer
